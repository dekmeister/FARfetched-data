{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/DEK-DEBIAN/FARfetched-data/schemas/provision.schema.json",
  "title": "Provision",
  "description": "One citable provision (CFR section, CS paragraph, ...) and its text at each revision. Lives at documents/{issuer}/{document}/{number}.json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "issuer",
    "document",
    "number",
    "current_grouping",
    "canonical_title",
    "versions"
  ],
  "properties": {
    "issuer": { "$ref": "common.schema.json#/$defs/issuer" },
    "document": { "$ref": "common.schema.json#/$defs/slug" },
    "number": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9.-]*$" },
    "current_grouping": { "type": ["string", "null"] },
    "canonical_title": { "type": "string", "minLength": 1 },
    "subject_group": { "type": ["string", "null"] },
    "versions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/version" }
    }
  },
  "$defs": {
    "version": {
      "type": "object",
      "additionalProperties": false,
      "required": ["designator", "title_at_revision"],
      "oneOf": [
        { "required": ["text"] },
        { "required": ["same_as_designator"] },
        { "required": ["deleted"] }
      ],
      "properties": {
        "designator": { "$ref": "common.schema.json#/$defs/designator" },
        "grouping_at_time": { "type": ["string", "null"] },
        "title_at_revision": { "type": "string", "minLength": 1 },
        "text": {
          "description": "Label-line text (README, Text format). Tabs and carriage returns are not allowed; lines are separated by \\n.",
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\t\\r]*$"
        },
        "same_as_designator": { "$ref": "common.schema.json#/$defs/designator" },
        "deleted": {
          "description": "The revision deleted (removed, repealed) this provision. Replaces text; a later version may re-create it.",
          "const": true
        },
        "publication_cite": {
          "type": "string",
          "not": { "const": "Initial Adoption" }
        },
        "source_url": { "$ref": "common.schema.json#/$defs/uri_or_null" },
        "actions": {
          "type": "array",
          "items": { "$ref": "#/$defs/action" }
        },
        "provenance": { "$ref": "common.schema.json#/$defs/provenance" }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "enum": [
            "nprm",
            "final_rule",
            "direct_final_rule",
            "interim_final_rule",
            "easa_npa",
            "easa_opinion",
            "easa_decision",
            "jar_npa",
            "jar_change",
            "other"
          ]
        },
        "reference": { "type": ["string", "null"] },
        "issued_on": { "$ref": "common.schema.json#/$defs/date_or_null" },
        "source_url": { "$ref": "common.schema.json#/$defs/uri_or_null" },
        "notes": { "type": ["string", "null"] }
      }
    }
  }
}
