{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/DEK-DEBIAN/FARfetched-data/schemas/aircraft_model.schema.json",
  "title": "Aircraft model",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manufacturer",
    "model_designation",
    "common_name",
    "notes",
    "tcb"
  ],
  "properties": {
    "manufacturer": { "type": "string", "minLength": 1 },
    "model_designation": { "type": "string", "minLength": 1 },
    "common_name": { "type": ["string", "null"] },
    "notes": { "type": ["string", "null"] },
    "tcb": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/tcb" }
    }
  },
  "$defs": {
    "categories": {
      "description": "Airworthiness categories as stated on this TCDS. Must match _CATEGORY_NAMES in build.py.",
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "transport",
          "normal",
          "utility",
          "acrobatic",
          "commuter",
          "restricted",
          "limited",
          "provisional",
          "primary",
          "special"
        ]
      },
      "uniqueItems": true
    },
    "tcb": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tcds", "categories", "notes", "certification_basis"],
      "properties": {
        "tcds": { "$ref": "#/$defs/tcds" },
        "categories": { "$ref": "#/$defs/categories" },
        "notes": { "type": ["string", "null"] },
        "certification_basis": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/entry" }
        }
      }
    },
    "tcds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issuer", "tcds_number"],
      "properties": {
        "issuer": { "$ref": "common.schema.json#/$defs/issuer" },
        "tcds_number": { "type": "string", "minLength": 1 },
        "revision": { "type": ["string", "null"] },
        "revision_date": { "$ref": "common.schema.json#/$defs/date_or_null" },
        "source_url": { "$ref": "common.schema.json#/$defs/uri_or_null" }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "display_order",
        "entry_type",
        "raw_reference",
        "applicability",
        "applicability_notes",
        "references"
      ],
      "properties": {
        "display_order": { "type": "integer", "minimum": 1 },
        "entry_type": {
          "enum": [
            "regulation",
            "special_condition",
            "elos",
            "exemption",
            "other"
          ]
        },
        "raw_reference": { "type": "string", "minLength": 1 },
        "applicability": { "type": ["string", "null"] },
        "applicability_notes": { "type": ["string", "null"] },
        "references": {
          "type": "array",
          "items": { "$ref": "#/$defs/reference" }
        },
        "citations": {
          "description": "Sections this line explicitly cites, read by the tools. Not part of the basis.",
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/citation" }
        },
        "citation_gaps": {
          "description": "Section-like citations on this line that are not linked, and why.",
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/citation_gap" }
        }
      },
      "if": {
        "properties": {
          "entry_type": { "enum": ["elos", "special_condition", "exemption"] }
        }
      },
      "else": {
        "not": {
          "anyOf": [
            { "required": ["citations"] },
            { "required": ["citation_gaps"] }
          ]
        }
      }
    },
    "citation": {
      "description": "One provision a line cites. `number` is the printed number, read at `at`, or at the latest revision when there is no `at`.",
      "type": "object",
      "additionalProperties": false,
      "required": ["issuer", "document", "number"],
      "properties": {
        "issuer": { "$ref": "common.schema.json#/$defs/issuer" },
        "document": { "$ref": "common.schema.json#/$defs/slug" },
        "number": { "type": "string", "minLength": 1 },
        "paragraph": { "type": "string", "minLength": 1 },
        "at": { "$ref": "common.schema.json#/$defs/designator" }
      }
    },
    "citation_gap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cited", "reason"],
      "properties": {
        "cited": { "type": "string", "minLength": 1 },
        "reason": {
          "enum": [
            "doc_not_in_dataset",
            "section_not_in_document",
            "document_undetermined",
            "range_not_expanded",
            "withheld_basis_list"
          ]
        }
      }
    },
    "reference": {
      "description": "One interpretation clause. No `provisions` = the whole document. Include refs need `to`; the base revision is always included.",
      "type": "object",
      "additionalProperties": false,
      "required": ["issuer", "document"],
      "properties": {
        "issuer": { "$ref": "common.schema.json#/$defs/issuer" },
        "document": { "$ref": "common.schema.json#/$defs/slug" },
        "to": { "$ref": "common.schema.json#/$defs/designator" },
        "skip": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/designator" }
        },
        "provisions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "paragraph": { "type": "string", "minLength": 1 },
        "effect": { "enum": ["include", "exclude"] }
      },
      "if": {
        "properties": { "effect": { "const": "exclude" } },
        "required": ["effect"]
      },
      "then": {
        "required": ["provisions"],
        "not": {
          "anyOf": [
            { "required": ["to"] },
            { "required": ["skip"] },
            { "required": ["paragraph"] }
          ]
        }
      },
      "else": {
        "required": ["to"],
        "dependentSchemas": {
          "paragraph": {
            "required": ["provisions"],
            "properties": { "provisions": { "maxItems": 1 } }
          }
        }
      }
    }
  }
}
