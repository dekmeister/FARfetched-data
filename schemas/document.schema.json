{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/DEK-DEBIAN/FARfetched-data/schemas/document.schema.json",
  "title": "Document",
  "description": "Document-level metadata and master revision list (a CFR part, CAR, EASA CS, ...). Lives at documents/{issuer}/{slug}/_document.json.",
  "type": "object",
  "additionalProperties": false,
  "required": ["issuer", "doc_kind", "code", "slug", "title", "revisions"],
  "properties": {
    "issuer": { "$ref": "common.schema.json#/$defs/issuer" },
    "doc_kind": {
      "enum": [
        "regulation",
        "certification_spec",
        "amc_gm",
        "advisory_circular",
        "handbook",
        "special_condition",
        "elos",
        "exemption",
        "standard"
      ]
    },
    "code": { "type": "string", "minLength": 1 },
    "slug": { "$ref": "common.schema.json#/$defs/slug" },
    "title": { "type": ["string", "null"] },
    "revisions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/revision" }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "doc_kind": { "const": "regulation" } } },
      "then": {
        "properties": {
          "revisions": {
            "items": {
              "properties": {
                "designator": { "pattern": "^[A-Za-z0-9]+-[0-9]+$" }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["designator", "ordinal", "effective_date"],
      "properties": {
        "designator": { "$ref": "common.schema.json#/$defs/designator" },
        "ordinal": { "type": "integer", "minimum": 0 },
        "effective_date": { "$ref": "common.schema.json#/$defs/date" },
        "provenance": { "$ref": "common.schema.json#/$defs/provenance" }
      }
    }
  }
}
