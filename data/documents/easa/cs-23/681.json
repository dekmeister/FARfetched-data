  "subject_group": null,
  "versions": [
    {
      "designator": "CS23-0",
      "grouping_at_time": "Subpart D \u2014 Design and Construction",
      "title_at_revision": "Limit load static tests",
      "text": "(a) Compliance with the limit load require-ments of CS-23 must be shown by tests in which \u2013\n  (1) The direction of the test loads produces the most severe loading in the control system; and\n  (2) Each fitting, pulley and bracket used in attaching the system to the main structure is included.\n(b) Compliance must be shown (by analyses or individual load tests) with the special factor requirements for control system joints subject to angular motion.",
