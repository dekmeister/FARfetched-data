  "canonical_title": "Materials and workmanship",
  "subject_group": null,
  "versions": [
    {
      "designator": "CS23-0",
      "grouping_at_time": "Subpart D \u2014 Design And Construction",
      "title_at_revision": "Materials and workmanship",
      "text": "(See AMC 23.603)\n(a) The suitability and durability of materials used for parts, the failure of which could adversely affect safety, must \u2013\n  (1) Be established by experience or tests;\n  (2) Meet approved specifications that ensure their having the strength and other properties assumed in the design data; and\n  (3) Take into account the effects of environmental conditions, such as temperature and humidity, expected in service.\n(b) Workmanship must be of a high standard.",
      "publication_cite": "ED Decision 2003/014/RM",
      "source_url": "https://www.easa.europa.eu/en/downloads/1615/en",
