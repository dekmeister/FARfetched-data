  "subject_group": null,
  "versions": [
    {
      "designator": "CS23-0",
      "grouping_at_time": "Subpart B \u2014 Flight",
      "title_at_revision": "Load distribution limits",
      "text": "(a) Ranges of weight and centres of gravity within which the aeroplane may be safely operated must be established and must include the range for lateral centres of gravity if possible loading conditions can result in significant variation of their positions.\n(b) The load distribution must not exceed \u2013\n  (1) The selected limits;\n  (2) The limits at which the structure is proven; or\n  (3) The limits at which compliance with each applicable flight requirement of this subpart is shown.",
