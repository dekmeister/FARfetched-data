  "canonical_title": "Main float buoyancy",
  "subject_group": null,
  "versions": [
    {
      "designator": "CS23-0",
      "grouping_at_time": "Subpart D \u2014 Design and Construction",
      "title_at_revision": "Main float buoyancy",
      "text": "(a) Each main float must have \u2013\n  (1) A buoyancy of 80% in excess of the buoyancy required by that float to support its portion of the maximum weight of the seaplane or amphibian in fresh water; and\n  (2) Enough watertight compartments to provide reasonable assurance that the seaplane or amphibian will stay afloat without capsizing if any two compartments of any main float are flooded.\n(b) Each main float must contain at least four watertight compartments approximately equal in volume.",
