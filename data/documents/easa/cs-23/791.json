  "canonical_title": "Passenger information signs",
  "subject_group": null,
  "versions": [
    {
      "designator": "CS23-0",
      "grouping_at_time": "Subpart D \u2014 Design and Construction",
      "title_at_revision": "Passenger information signs",
      "text": "For those aeroplanes in which the flight crew members can not observe the other occupants seats or in which the crew compartment is separated from the passenger compartment, there must be at least one illuminated sign (using either letters or symbols) notifying all passengers when safety belts must be fastened. Signs that notify when seat belts should be fastened must \u2013\n(a) When illuminated, be legible to each person seated in the passenger compartment under all probable lighting conditions; and\n(b) Be installed so that a flight-crew member can, when seated at their station, turn the illumination on and off.",
