    {
      "designator": "27-20",
      "grouping_at_time": "Powerplant",
      "title_at_revision": "Oil system drains.",
      "text": "[A drain (or drains) must be provided to allow safe drainage of the oil system. Each drain must--\n(a) Be accessible; and\n(b) Have manual or automatic means for positive locking in the closed position.]",
